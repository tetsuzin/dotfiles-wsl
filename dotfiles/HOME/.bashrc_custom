# WSL2 から Windows 側の SSH エージェントを利用するための設定
if [ -f ~/.ssh/wsl2-ssh-agent ]; then
  eval "$(~/.ssh/wsl2-ssh-agent)"
fi

# dotnet コマンドの補完を有効化
if command -v dotnet &> /dev/null; then
  eval "$(dotnet completions script bash)"

  _dotnet_bash_complete() {
    local word=${COMP_WORDS[COMP_CWORD]}
    local dotnet_completion=( $(dotnet complete --position ${COMP_POINT} "${COMP_LINE}") )

    # .NET CLI の候補がある場合はそれを表示
    if [[ ${#dotnet_completion[@]} -gt 0 ]]; then
      COMPREPLY=( $(compgen -W "${dotnet_completion[*]}" -- "$word") )
    else
      # 候補がない（パス入力時など）は、通常のファイル/パス補完を行う
      COMPREPLY=( $(compgen -f -- "$word") )
    fi
  }

  complete -f -o plusdirs -F _dotnet_bash_complete dotnet

fi

# zoxide の有効化
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init bash)"
fi

# Statship の有効化
if command -v starship &> /dev/null; then
  export STARSHIP_KUBERNETES_ENABLED=1

  kubeon() {
    export STARSHIP_KUBERNETES_ENABLED=1
  }

  kubeoff() {
    unset STARSHIP_KUBERNETES_ENABLED
  }

  eval "$(starship init bash)"
fi

