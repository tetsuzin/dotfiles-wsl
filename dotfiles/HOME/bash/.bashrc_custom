export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# dotnet tools でインストールしたツールにパスを通す
export PATH="$HOME/.dotnet/tools:$PATH"

# WSL2 から Windows 側の SSH エージェントを利用するための設定
eval "$(~/.ssh/wsl2-ssh-agent)"

# Windows 側の Docker に接続する
export DOCKER_HOST="tcp://localhost:2375"

# dotnet コマンドの補完を有効化
eval "$(dotnet completions script bash)"

# Statship の有効化
eval "$(starship init bash)"

# Startship で kube_ps1 を利用するための設定
kubectl config set-context starship-context --namespace astronaut

